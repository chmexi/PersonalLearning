[Unit]
Description=DaoHen journal API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/daohen-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/daohen-server/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5001 --timeout 300 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/daohen-server

[Install]
WantedBy=multi-user.target
